# Lab 8 v3 configuration
# LLM mode (mock | local | api) is chosen per request via the UI dropdown or ?mode=...,
# so it is NOT set here. The settings below apply only to "local" (Ollama) mode.
# Local Ollama mode
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_THINK=false
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096
LLM_TIMEOUT_SEC=60

# Cloud "api" mode — Google Gemini. Only needed when running mode=api.
# Paste your key here in your real .env (this file is the committed template).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SEC=60
# 0 = tat "thinking" (latency thap cho lab); tang len (vd 1024) de reasoning sau hon
GEMINI_THINKING_BUDGET=0
